{
 "chunk_size": 10,
 "max_age_days": 30,
 "search_print_per_tier": 14,
 "tier_order": [
  "home",
  "nearby",
  "remote"
 ],
 "title_keywords": [
  "<short keyword, whole word>",
  "<longer keyword, substring>"
 ],
 "title_exclude": [
  "werkstudent",
  "praktik",
  "intern",
  "ausbildung",
  "trainee",
  "junior"
 ],
 "local_places": {
  "home": [
   "<your town>",
   "<neighbouring town>"
  ],
  "nearby": [
   "<big city in commute range>"
  ]
 },
 "ba_searches": [
  {
   "tier": "home",
   "what": "<search term>",
   "where": "<your town>",
   "radius_km": 25,
   "size": 100
  },
  {
   "tier": "nearby",
   "what": "<search term>",
   "where": "<big city>",
   "radius_km": 15,
   "size": 100
  },
  {
   "tier": "remote",
   "what": "<search term>",
   "homeoffice_only": true,
   "size": 100
  }
 ],
 "arbeitnow": {
  "enabled": true,
  "pages": 3
 },
 "web_searches_per_run": 2,
 "web_queries": [
  "<role> remote <country> jobs.ashbyhq.com",
  "<role> <your town> Stellenangebot Karriere"
 ],
 "target_companies_per_run": 3,
 "stepstone_searches": [
  {
   "tier": "home",
   "what": "<search term>",
   "where": "<your town>",
   "radius_km": 30
  },
  {
   "tier": "remote",
   "what": "<search term>",
   "homeoffice_only": true
  }
 ],
 "max_recruiter_jobs_per_chunk": 2,
 "recruiter_names": [
  "<part of a recruiter's or staffing agency's company name>",
  "personalberatung",
  "zeitarbeit",
  "recruit",
  "staffing"
 ],
 "recruiter_hosts": [
  "<job-site host that only carries staffing agencies>"
 ],
 "aggregator_hosts": [
  "jobleads.com",
  "wearedevelopers.com",
  "builtin.com",
  "indeed.com",
  "glassdoor.com",
  "xing.com"
 ],
 "scheduled_run": {
  "skip_when_rows_at_least": 10,
  "spreadsheet_id": "<spreadsheet id>",
  "range": "'<scout tab name>'!A<header row>:G",
  "url_header": "<exact header of the URL column>"
 }
}
